@model BookStoreKAP.Models.PromotionViewModel
@{
    ViewBag.Title = Model?.ID != null && Model?.ID != Guid.Empty ? "Chỉnh sửa khuyến mãi" : "Tạo khuyến mãi mới";
}
<div class="container">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="text-center">@ViewBag.Title</h3>
        </div>
        <div class="col-lg-12">
            @if (TempData[BookStoreKAP.Common.Constants.ToastrConstant.SUCCESS_MSG] != null)
            {
                <div class="alert alert-success alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                    <h5><i class="icon fas fa-check"></i> Thành công!</h5>
                    @TempData[BookStoreKAP.Common.Constants.ToastrConstant.SUCCESS_MSG]
                </div>
            }
            @if (TempData[BookStoreKAP.Common.Constants.ToastrConstant.ERROR_MSG] != null)
            {
                <div class="alert alert-danger alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                    <h5><i class="icon fas fa-ban"></i> Lỗi!</h5>
                    @TempData[BookStoreKAP.Common.Constants.ToastrConstant.ERROR_MSG]
                </div>
            }
            <form asp-action="@(Model?.ID != null && Model?.ID != Guid.Empty ? "Modify" : "Create")" method="POST" id="frmCreatePromotion">
                <input type="hidden" asp-for="ID" />
                <div class="row">
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label class="form-label" for="txtName">Tên khuyến mãi <span class="required text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtName" asp-for="Name" rules="required" placeholder="Nhập tên khuyến mãi..." />
                            <span class="text-danger text-sm-center form-message" hidden></span>
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label class="form-label" for="cboPromotionType">Loại khuyến mãi <span class="required text-danger">*</span></label>
                            <select class="form-control" id="cboPromotionType" asp-for="PromotionType" rules="required">
                                <option value="">-- Chọn loại khuyến mãi --</option>
                                <option value="1">Khuyến mãi theo series</option>
                                <option value="2">Khuyến mãi theo sách cụ thể</option>
                            </select>                            <span class="text-danger text-sm-center form-message" hidden></span>
                            <span asp-validation-for="PromotionType" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-12 mt-2">
                        <div class="form-group">
                            <label class="form-label" for="txtDescription">Mô tả</label>
                            <textarea class="form-control" id="txtDescription" asp-for="Description" rows="3" placeholder="Nhập mô tả khuyến mãi..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                    <!-- Phần chọn series - hiển thị khi PromotionType là "Series" -->
                    <div class="col-lg-12 mt-2 promotion-type-section" id="series-section" style="display: none;">
                        <div class="form-group">
                            <label class="form-label" for="cboSeries">Series sách <span class="required text-danger">*</span></label>
                            <select class="form-control" id="cboSeries" asp-for="SeriesID" rules="required">
                                <option value="">-- Chọn series sách --</option>
                                @if (ViewBag.Series != null)
                                {
                                    foreach (var series in ViewBag.Series)
                                    {
                                        <option value="@series.ID">@series.Name</option>
                                    }
                                }
                            </select>
                            <span class="text-danger text-sm-center form-message" hidden></span>
                            <span asp-validation-for="SeriesID" class="text-danger"></span>
                        </div>
                    </div>
                    <!-- Phần chọn sách cụ thể - hiển thị khi PromotionType là "Books" -->
                    <div class="col-lg-12 mt-2 promotion-type-section" id="books-section" style="display: none;">
                        <div class="form-group">
                            <label class="form-label">Chọn sách <span class="required text-danger">*</span></label>
                            <div class="row mb-2">
                                <div class="col-lg-4">
                                    <select class="form-control" id="filterSeries">
                                        <option value="">-- Lọc theo series --</option>
                                        @if (ViewBag.Series != null)
                                        {
                                            foreach (var series in ViewBag.Series)
                                            {
                                                <option value="@series.ID">@series.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-lg-6">
                                    <input type="text" class="form-control" id="searchBooks" placeholder="Tìm kiếm sách theo tên, tác giả...">
                                </div>
                                <div class="col-lg-2">
                                    <button type="button" class="btn btn-primary" id="selectAllBooks">Chọn tất cả</button>
                                </div>
                            </div>
                            <div class="book-selection-container" style="max-height: 300px; overflow-y: auto; border: 1px solid #ddd; padding: 10px;">
                                <div class="row" id="booksContainer">
                                    @if (ViewBag.Books != null)
                                    {
                                        foreach (var book in ViewBag.Books)
                                        {
                                            string seriesName = "N/A";
                                            if (ViewBag.Series != null)
                                            {
                                                foreach (var series in ViewBag.Series)
                                                {
                                                    if (series.ID == book.SeriesID)
                                                    {
                                                        seriesName = series.Name;
                                                        break;
                                                    }
                                                }
                                            }
                                            
                                            <div class="col-md-6 mb-2 book-item" data-series-id="@book.SeriesID" data-title="@book.Title.ToLower()" data-author="@book.Author.ToLower()">
                                                <div class="custom-control custom-checkbox">
                                                    <input type="checkbox" class="custom-control-input book-checkbox"
                                                           id="book_@book.Id"
                                                           name="SelectedBookIds"
                                                           value="@book.Id"
                                                           @if(Model?.SelectedBookIds != null && Model.SelectedBookIds.Contains(book.Id)) { <text>checked</text> }>
                                                    <label class="custom-control-label" for="book_@book.Id">
                                                        @book.Title - @book.Author (@seriesName, @book.Price.ToString("N0") VNĐ)
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                            <span class="text-danger text-sm-center form-message" hidden></span>
                            <span class="text-danger" id="booksValidationMsg"></span>
                        </div>
                    </div>
                    <div class="col-lg-4 mt-2">
                        <div class="form-group">
                            <label class="form-label" for="txtStartDate">Ngày bắt đầu <span class="required text-danger">*</span></label>
                            <input type="date" class="form-control" id="txtStartDate" asp-for="StartDate" rules="required" />
                            <span class="text-danger text-sm-center form-message" hidden></span>
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-4 mt-2">
                        <div class="form-group">
                            <label class="form-label" for="txtEndDate">Ngày kết thúc <span class="required text-danger">*</span></label>
                            <input type="date" class="form-control" id="txtEndDate" asp-for="EndDate" rules="required" />
                            <span class="text-danger text-sm-center form-message" hidden></span>
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-4 mt-2">
                        <div class="form-group">
                            <label class="form-label" for="txtDiscountPercent">Phần trăm giảm giá (%) <span class="required text-danger">*</span></label>
                            <input type="number" class="form-control" id="txtDiscountPercent" asp-for="DiscountPercent" rules="required" min="1" max="100" />
                            <span class="text-danger text-sm-center form-message" hidden></span>
                            <span asp-validation-for="DiscountPercent" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-12 mt-3">
                        <div class="d-flex justify-content-end">
                            <a href="@Url.Action("Index", new { menuKey = "PM" })" class="btn btn-secondary me-2">Hủy</a>
                            <button type="submit" class="btn btn-success">@(Model?.ID != null && Model?.ID != Guid.Empty ? "Cập nhật" : "Tạo mới")</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function() {
            function init() {
                Validator("#frmCreatePromotion");
                
                // Set minimum date for start date to today
                const today = new Date().toISOString().split('T')[0];
                $("#txtStartDate").attr("min", today);
                
                // Ensure end date is after start date
                $("#txtStartDate").on("change", function() {
                    const startDate = $(this).val();
                    if(startDate) {
                        $("#txtEndDate").attr("min", startDate);
                        // If end date is before start date, reset it
                        const endDate = $("#txtEndDate").val();
                        if(endDate && endDate < startDate) {
                            $("#txtEndDate").val(startDate);
                        }
                    }
                });
                
                // Handle promotion type change
                $("#cboPromotionType").on("change", function() {
                    togglePromotionTypeSections();
                    clearValidationErrors();
                });
                
                // Initialize sections based on current promotion type
                togglePromotionTypeSections();
                
                // Gợi ý khi chọn series
                $("#cboSeries").on("change", function() {
                    const selectedText = $(this).find("option:selected").text();
                    if (selectedText && selectedText !== "-- Chọn series sách --") {
                        const suggestedName = "Khuyến mãi series " + selectedText;
                        const suggestedDesc = "Giảm giá đặc biệt cho series " + selectedText + ".";
                        // Chỉ gợi ý nếu người dùng chưa nhập thông tin
                        if (!$("#txtName").val()) {
                            $("#txtName").val(suggestedName);
                        }
                        if (!$("#txtDescription").val()) {
                            $("#txtDescription").val(suggestedDesc);
                        }
                    }
                });
                
                // Validate dates on form submission
                $("#frmCreatePromotion").on("submit", function(e) {
                    const startDate = $("#txtStartDate").val();
                    const endDate = $("#txtEndDate").val();
                    if(new Date(endDate) <= new Date(startDate)) {
                        e.preventDefault();
                        alert("Ngày kết thúc phải sau ngày bắt đầu!");
                        return false;
                    }
                    
                    // Kiểm tra loại khuyến mãi và validate tương ứng
                    const promotionType = $("#cboPromotionType").val();
                    if (!promotionType) {
                        e.preventDefault();
                        alert("Vui lòng chọn loại khuyến mãi!");
                        return false;
                    }
                    
                    if (promotionType === "Series" && !$("#cboSeries").val()) {
                        e.preventDefault();
                        alert("Vui lòng chọn series sách cho khuyến mãi!");
                        return false;
                    }
                    
                    if (promotionType === "Books" && $(".book-checkbox:checked").length === 0) {
                        e.preventDefault();
                        $("#booksValidationMsg").text("Vui lòng chọn ít nhất một sách cho khuyến mãi!");
                        alert("Vui lòng chọn ít nhất một sách cho khuyến mãi!");
                        return false;
                    }
                    
                    return true;
                });
                
                // Xử lý tìm kiếm sách
                $("#searchBooks").on("keyup", function() {
                    const searchText = $(this).val().toLowerCase();
                    filterBooks(searchText);
                });
                
                // Xử lý lọc sách theo series
                $("#filterSeries").on("change", function() {
                    const selectedSeriesId = $(this).val();
                    const searchText = $("#searchBooks").val().toLowerCase();
                    filterBooks(searchText, selectedSeriesId);
                });
                
                // Xử lý chọn tất cả sách
                $("#selectAllBooks").on("click", function() {
                    const visibleBooks = $(".book-item:visible .book-checkbox");
                    if (visibleBooks.length > 0) {
                        const anyUnchecked = visibleBooks.filter(":not(:checked)").length > 0;
                        if (anyUnchecked) {
                            // Nếu có sách chưa được chọn, chọn tất cả
                            visibleBooks.prop("checked", true);
                        } else {
                            // Nếu tất cả đã được chọn, bỏ chọn tất cả
                            visibleBooks.prop("checked", false);
                        }
                    }
                });
                
                // Nếu là chỉnh sửa, tự động hiển thị section phù hợp
                if ($("#cboPromotionType").val()) {
                    togglePromotionTypeSections();
                }
            }
            
            function clearValidationErrors() {
                $("#booksValidationMsg").text("");
                // Xóa các lỗi validation khác nếu cần
            }
            
            function togglePromotionTypeSections() {
                const promotionType = $("#cboPromotionType").val();
                // Hide all sections first
                $(".promotion-type-section").hide();
                
                // Show the appropriate section based on selection
                if (promotionType == 1) {
                    $("#series-section").show();
                    // Thêm validation cho series
                    $("#cboSeries").attr("rules", "required");
                    // Loại bỏ validation cho books nếu có
                    $(".book-checkbox").removeAttr("rules");
                } else if (promotionType == 2) {
                    $("#books-section").show();
                    // Loại bỏ validation cho series
                    $("#cboSeries").removeAttr("rules");
                    // Có thể thêm validation cho books nếu cần
                }
            }
            
            function filterBooks(searchText = "", seriesId = "") {
                $(".book-item").each(function() {
                    const bookTitle = $(this).data("title");
                    const bookAuthor = $(this).data("author");
                    const bookSeriesId = $(this).data("series-id");
                    
                    const matchesSearch = !searchText || 
                        bookTitle.includes(searchText) || 
                        bookAuthor.includes(searchText);
                        
                    const matchesSeries = !seriesId || bookSeriesId == seriesId;
                    
                    if (matchesSearch && matchesSeries) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            }
            
            init();
        });
    </script>
}