@model List<BookStoreKAP.Models.PromotionViewModel>
@{
    ViewData["Title"] = "Promotions";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Promotions</h3>
                    <div class="card-tools">
                        <a href="@Url.Action("Create", new { menuKey = "PM" })" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus"></i> Add New
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (TempData[BookStoreKAP.Common.Constants.ToastrConstant.SUCCESS_MSG] != null)
                    {
                        <div class="alert alert-success alert-dismissible">
                            <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                            <h5><i class="icon fas fa-check"></i> Success!</h5>
                            @TempData[BookStoreKAP.Common.Constants.ToastrConstant.SUCCESS_MSG]
                        </div>
                    }
                    @if (TempData[BookStoreKAP.Common.Constants.ToastrConstant.ERROR_MSG] != null)
                    {
                        <div class="alert alert-danger alert-dismissible">
                            <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                            <h5><i class="icon fas fa-ban"></i> Error!</h5>
                            @TempData[BookStoreKAP.Common.Constants.ToastrConstant.ERROR_MSG]
                        </div>
                    }

                    <form id="frmSearchPromotion" asp-action="Index" method="get">
                        <input type="hidden" name="menuKey" value="PM" />
                        <div class="row mb-3">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Promotion Name</label>
                                    <input type="text" class="form-control" name="Name" value="@ViewBag.SearchValue?.Name" placeholder="Enter promotion name...">
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Tag</label>
                                    <select class="form-control" name="TagID">
                                        <option value="">All Tags</option>
                                        @if (ViewBag.Tags != null)
                                        {
                                            foreach (var tag in ViewBag.Tags)
                                            {
                                                <option value="@tag.ID">@tag.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Status</label>
                                    <select class="form-control" name="Status">
                                        <option value="">All Status</option>
                                        @{
                                            var activeSelected = ViewBag.SearchValue?.Status == "Active" ? "selected" : "";
                                            var upcomingSelected = ViewBag.SearchValue?.Status == "Upcoming" ? "selected" : "";
                                            var expiredSelected = ViewBag.SearchValue?.Status == "Expired" ? "selected" : "";
                                        }
                                       
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-search"></i> Search
                                </button>
                                <a href="@Url.Action("Index", new { menuKey = "PM" })" class="btn btn-secondary ml-2">
                                    <i class="fas fa-sync"></i> Reset
                                </a>
                            </div>
                        </div>
                    </form>

                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Tag</th>
                                <th>Discount</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    var status = "";
                                    var statusClass = "";
                                    var currentDate = DateTime.Now;

                                    if (item.StartDate > currentDate)
                                    {
                                        status = "Upcoming";
                                        statusClass = "badge-warning";
                                    }
                                    else if (item.EndDate < currentDate)
                                    {
                                        status = "Expired";
                                        statusClass = "badge-danger";
                                    }
                                    else
                                    {
                                        status = "Active";
                                        statusClass = "badge-success";
                                    }

                                    <tr>
                                        <td>@item.Name</td>
                                        <td>@item.TagName</td>
                                        <td>@item.DiscountPercent%</td>
                                        <td>@item.StartDate.ToString("dd/MM/yyyy")</td>
                                        <td>@item.EndDate.ToString("dd/MM/yyyy")</td>
                                        <td><span class="badge-black @statusClass">@status</span></td>

                                        <td>
                                            <div class="btn-group">
                                                <a href="@Url.Action("Modify", new { id = item.ID, menuKey = "PM" })" class="btn btn-info btn-sm">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                @if (status == "Active")
                                                {
                                                    <button type="button" class="btn btn-warning btn-sm end-promotion" data-id="@item.ID">
                                                        <i class="fas fa-stop"></i>
                                                    </button>
                                                }
                                                <button type="button" class="btn btn-danger btn-sm delete-promotion" data-id="@item.ID">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center">No promotions found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @* @if (ViewBag.Pagination != null) *@
                    @* { *@
                    @*     <div class="mt-3"> *@
                    @*         <partial name="_Pagination" model="ViewBag.Pagination" /> *@
                    @*     </div> *@
                    @* } *@
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function() {
            // Xử lý xóa promotion
            $('.delete-promotion').click(function() {
                var id = $(this).data('id');
                Swal.fire({
                    title: 'Are you sure?',
                    text: "You are about to delete this promotion. This action cannot be undone!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("RemovePromotionByIDAPI")',
                            type: 'POST',
                            data: { id: id },
                            success: function(response) {
                                if (response.success) {
                                    Swal.fire('Deleted!', response.message, 'success').then(() => {
                                        location.reload();
                                    });
                                } else {
                                    Swal.fire('Error!', response.message, 'error');
                                }
                            },
                            error: function() {
                                Swal.fire('Error!', 'An error occurred while processing your request.', 'error');
                            }
                        });
                    }
                });
            });

            // Xử lý kết thúc promotion
            $('.end-promotion').click(function() {
                var id = $(this).data('id');
                Swal.fire({
                    title: 'End Promotion?',
                    text: "This will end the promotion immediately. Books will no longer receive this discount.",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#f39c12',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, end it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("EndPromotionAPI")',
                            type: 'POST',
                            data: { id: id },
                            success: function(response) {
                                if (response.success) {
                                    Swal.fire('Done!', response.message, 'success').then(() => {
                                        location.reload();
                                    });
                                } else {
                                    Swal.fire('Error!', response.message, 'error');
                                }
                            },
                            error: function() {
                                Swal.fire('Error!', 'An error occurred while processing your request.', 'error');
                            }
                        });
                    }
                });
            });
        });
    </script>
}