@{
    ViewData["Title"] = ViewBag.Service;
}
<input hidden name="service" value="@ViewBag.Service" />
<input hidden name="genresId" value="@ViewBag.GenresID" />
<input hidden name="currentSortBy" value="@ViewBag.SortBy" />

<div class="container">
    <div class="breadcrumb-wrap">
        <a href="@(RouteConstant.HOME)">Home</a>
        <span>&#10095;</span>
        <p>@(ViewBag.Hambuger)</p>
    </div>
    <div class="row">
        <div class="col-lg-2">
            <div class="side-bar">
                <div class="side-category">
                    <h6>Genres</h6>
                        <form id="filterForm" method="get" action="@RouteConstant.LIST">
                            <input type="hidden" name="Service" value="@ViewBag.Service" />
                            <input type="hidden" name="Hambuger" value="@ViewBag.Hambuger" />

                            <div class="side-bar-item-child">
                                @foreach (var genre in ViewBag.Genres)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input genre-checkbox" type="checkbox" name="genresId" value="@genre.ID"
                                        @(ViewBag.GenresID != null && ViewBag.GenresID.Contains(genre.ID.ToString()) ? "checked" : "") />
                                        <label class="form-check-label">@genre.Name</label>
                                    </div>
                                }

                                <button type="submit" class="btn btn-primary mt-2">Apply Filters</button>
                                <button type="button" class="btn btn-secondary mt-2" id="clearFilters">Clear</button>

                            </div>

                        </form>

                    <div class="side-bar-item">
                        <div class="side-bar-item-wrap-title">
                            <p><strong>Magazine</strong></p>
                            <span class="wrap-icon"><i class="bi bi-chevron-down"></i></span>
                        </div>
                        <div class="side-bar-item-child">
                            <div class="new-releases-child">
                                <span class="right-icon"><i class="bi bi-chevron-double-right"></i></span>
                                <a href="@(RouteConstant.LIST)?Service=@(ViewBag.Service)&Hambuger=@ViewBag.Service">Liberated Saigon</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="side-price">
                    <h6>PRICE RANGE</h6>
                    <div>
                        <div class="side-price-item">
                            <p>Price Range:</p>
                            <span>@(string.Format("{0:0,00#} VNĐ", 10000))</span>
                            <span>-</span>
                            <span>@(string.Format("{0:0,00#} VNĐ", 500000))</span>
                        </div>
                        <input type="hidden" name="maxPrice" id="hiddenMaxPrice" value="@ViewBag.MaxPrice" />
                        <input id="pricechange" type="range" min="10000" max="500000" value="@ViewBag.MaxPrice" />
                        <p>10000Đ - <span id="currentprice">@ViewBag.MaxPrice</span>Đ</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-10">
            <div id="book" class="row">
                @if (ViewBag.Books != null && ViewBag.Books.Count > 0)
                {
                    foreach (var book in ViewBag.Books)
                    {
                        <div class="col-lg-3">
                            <div class="card-product">
                                <div class="card-product-heading">
                                    <a href="@(RouteConstant.PRODUCT_DETAIL)/@book.ID">
                                        <img src="@book.Thumbnail" alt="@book.Title" />
                                    </a>
                                    <button>
                                        <i class="bi bi-suit-heart"></i>
                                    </button>
                                </div>
                                <div class="card-product-content">
                                    <h6 class="card-product-title">
                                        <a href="#">@book.Title</a>
                                    </h6>
                                    <div class="card-product-desc">
                                        <span><strong>Book Author: </strong></span>
                                        <span>@book.Author</span>
                                    </div>
                                    
                                        <div class="card-product-date">
                                            <span><strong>Publication: </strong></span>
                                            <span>@book.CreatedAt.ToString("dd/MM/yyyy")</span>
                                        </div>
                                        
                                            @* <div class="card-product-promo"> *@
                                            @*     <span class="promo-badge">-@ViewBag.CurrentPromotion.DiscountPercent%</span> *@
                                            @* </div> *@
                                        
                                    
                                        <div class="card-product-buy-count">
                                            <span><strong>Sold: </strong></span>
                                            <span>@book.BuyCount</span>
                                        </div>
                                        
                                            @* <div class="card-product-promo"> *@
                                            @*     <span class="promo-badge">-@ViewBag.CurrentPromotion.DiscountPercent%</span> *@
                                            @* </div> *@
                                        
                                    
                                    <div class="card-product-wrap-price">
                                        @if (book.Discount != book.Price)
                                        {
                                            <span class="card-product-current-price">@(string.Format("{0:0,00#} VNĐ", book.Discount))</span>
                                            <span class="card-product-old-price">@(string.Format("{0:0,00#} VNĐ", book.Price))</span>
                                        }
                                        else
                                        {
                                            <span class="card-product-current-price">@(string.Format("{0:0,00#} VNĐ", book.Discount))</span>
                                        }
                                    </div>
                                </div>
                                <div class="card-product-footer">
                                    <div class="card-product-wrap-btn">
                                        <button class="card-product-btn kap-btn kap-btn-primary btnBuyBook" data-bookID="@(book.ID)">
                                            BUY
                                        </button>
                                        <button class="card-product-btn kap-btn kap-btn-secondary btnAddToCart" data-bookID="@(book.ID)">ADD TO CART</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center">
                        <p>No books matching your filters were found.</p>
                    </div>
                }
            </div>
            <!-- Phân trang -->
            <div class="pagination-container">
                <nav>
                    <ul class="pagination">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@(RouteConstant.LIST)?Service=@ViewBag.Service&page=@(ViewBag.CurrentPage - 1)&Hambuger=@ViewBag.Hambuger
                                    @foreach (var genreId in (ViewBag.GenresID as List<string> ?? new List<string>()))
                                    {
                                        @($"&genresId={genreId}")
                                    }">Previous</a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link">Previous</span>
                            </li>
                        }
                        @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
                        {
                            if (i == ViewBag.CurrentPage)
                            {
                                <li class="page-item active">
                                    <span class="page-link">@i</span>
                                </li>
                            }
                            else
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@(RouteConstant.LIST)?Service=@ViewBag.Service&page=@i&Hambuger=@ViewBag.Hambuger
                                        @foreach (var genreId in (ViewBag.GenresID as List<string> ?? new List<string>()))
                                        {
                                            @($"&genresId={genreId}")
                                        }">@i</a>
                                </li>
                            }
                        }
                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@(RouteConstant.LIST)?Service=@ViewBag.Service&page=@(ViewBag.CurrentPage + 1)&Hambuger=@ViewBag.Hambuger
                                    @foreach (var genreId in (ViewBag.GenresID as List<string> ?? new List<string>()))
                                    {
                                        @($"&genresId={genreId}")
                                    }">Next</a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link">Next</span>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        // Hàm dùng để gắn sự kiện cho các nút BUY và ADD TO CART
        function attachEventHandlers() {
            $(".btnBuyBook").each(function () {
                $(this).on("click", function () {
                    const _this = this;
                    console.log(1);
                    if (!getAuthenticated()) {
                        $("#modalLogin").modal("show");
                    }
                    else {
                        const bookID = $(_this).attr("data-bookID");
                        handleAjax("/Cart/AddToCartAPI", { req: { BookID: bookID } }, (res) => {
                            if (res.success) {
                                toastr.success(res.message);
                                const count = getCountCartAPI();
                                $("#spanCartItemCount").text(count);
                                location.href = "https://localhost:5001/Cart";
                            } else {
                                toastr.error(res.message)
                            }
                        })
                    }
                })
            })
            $(".btnAddToCart").each(function () {
                $(this).on("click", function () {
                    const _this = this;
                    $(_this).html(`<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>Loading...`).prop("disabled", true);
                    if (!getAuthenticated()) {
                        $("#modalLogin").modal("show");
                    } else {
                        const bookID = $(_this).attr("data-bookID");
                        handleAjax("/Cart/AddToCartAPI", { req: { BookID: bookID } }, (res) => {
                            if (res.success) {
                                toastr.success(res.message);
                                const count = getCountCartAPI();
                                $("#spanCartItemCount").text(count);
                            } else {
                                toastr.error(res.message);
                            }
                        });
                    }
                    setTimeout(() => {
                        $(_this).html(`ADD TO CART`).prop("disabled", false)
                    }, 100)
                })
            })
        }

        // Thêm vào file script.js hoặc trong phần JS của trang
        $(document).ready(function () {
            let currentPage = 1;
            let selectedGenres = [];

            // Hiển thị giá trị ban đầu của thanh trượt
            $("#currentprice").text("500000");
            $("#pricechange").val(500000);

            // Lấy trang hiện tại từ URL nếu có
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has('page')) {
                currentPage = parseInt(urlParams.get('page')) || 1;
            }

            // Kiểm tra nếu có genres trong URL
            if(urlParams.has('genresId')) {
                // Lấy tất cả các giá trị genresId từ URL
                const genreIds = urlParams.getAll('genresId');
                if(genreIds && genreIds.length > 0) {
                    // Đánh dấu tất cả các checkbox tương ứng
                    genreIds.forEach(id => {
                        $(`.genre-checkbox[value="${id}"]`).prop('checked', true);
                        selectedGenres.push(id);
                    });
                }
            }

            // Xử lý sự kiện khi checkbox được click
            $(".genre-checkbox").on("change", function() {
                const genreId = $(this).val();
                if($(this).is(':checked')) {
                    // Thêm vào mảng nếu được chọn
                    if(!selectedGenres.includes(genreId)) {
                        selectedGenres.push(genreId);
                    }
                } else {
                    // Xóa khỏi mảng nếu bỏ chọn
                    selectedGenres = selectedGenres.filter(id => id !== genreId);
                }
            });

            // Xử lý nút Clear
            $("#clearFilters").on("click", function() {
                // Reset các checkbox
                $(".genre-checkbox").prop('checked', false);
                selectedGenres = [];
                // Reset giá về mặc định
                $("#pricechange").val(500000);
                $("#currentprice").text("500000");

                // Chuyển hướng về URL không có filter
                const service = $("input[name='service']").val();
                const hambuger = $("input[name='Hambuger']").val();
                window.location.href = `@RouteConstant.LIST?Service=${service}&Hambuger=${hambuger}`;
            });
                    // Hiển thị giá trị ban đầu của thanh trượt từ URL
        const maxPriceParam = urlParams.get('maxPrice') || '500000';
        $("#pricechange").val(maxPriceParam);
        $("#currentprice").text(maxPriceParam);
        $("#hiddenMaxPrice").val(maxPriceParam);

            // Xử lý sự kiện thay đổi giá
        $("#pricechange").on("input", function () {
            const value = $(this).val();
            $("#currentprice").text(value);
            $("#hiddenMaxPrice").val(value);
        });

            // Click nút Apply sau khi thay đổi giá
            $("#pricechange").on("change", function() {
                applyFilters();
            });

            // Xử lý form submit cho nhiều genres
            document.getElementById("filterForm").addEventListener("submit", function (e) {
                e.preventDefault();
                const form = this;
                const service = form.querySelector("input[name='Service']").value;
                const hambuger = form.querySelector("input[name='Hambuger']").value;

                // Get all checked genre checkboxes
                const checkedGenres = Array.from(form.querySelectorAll(".genre-checkbox:checked"))
                    .map(cb => cb.value);

                let url = `@RouteConstant.LIST?Service=${service}&Hambuger=${hambuger}`;

                // Add all genres to URL
                checkedGenres.forEach(genreId => {
                    url += `&genresId=${genreId}`;
                });

                // Add price range if changed
                const priceValue = $("#hiddenMaxPrice").val();
                if (priceValue && priceValue < 500000) {
                    url += `&maxPrice=${priceValue}`;
                }


                console.log("Submitting with URL:", url);
                window.location.href = url;
            });

            // Hàm áp dụng bộ lọc (sẽ được gọi khi thay đổi giá)
            function applyFilters() {
                // Use the form submit handler instead
                document.getElementById("filterForm").dispatchEvent(new Event('submit'));
            }

            // Attach event handlers cho các nút BUY và ADD TO CART
            attachEventHandlers();
        });
    </script>
    <style>
        .genre-filters {
            padding: 0 10px;
        }

        .genre-checkbox {
            display: flex;
            align-items: center;
            margin-bottom: 8px;
        }

            .genre-checkbox input {
                margin-right: 10px;
            }

        .filter-buttons {
            display: flex;
            justify-content: space-between;
            gap: 10px;
        }

            .filter-buttons button {
                flex: 1;
            }
    </style>
}