@model BookStoreKAP.Models.Entities.Promotion

@if (Model != null)
{
    <div class="promotion-banner">
        <div class="container">
            <div class="alert alert-info promotion-alert">
                <h4><i class="bi bi-tag"></i> @Model.Name</h4>
                <p>@Model.Description</p>
                <p>Giảm giá: <strong>@Model.DiscountPercent%</strong> cho sách</p>
                <p>Thời gian: @Model.StartDate.ToString("dd/MM/yyyy") - @Model.EndDate.ToString("dd/MM/yyyy")</p>
                <p class="text-danger">Còn @((Model.EndDate - DateTime.Now).Days) ngày nữa kết thúc!</p>
            </div>
        </div>
    </div>
}
